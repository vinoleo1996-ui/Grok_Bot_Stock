+    rep = dict(spec_sha256="2e428f3956fcb6d2de8204a0b7226242763045afdd280a4d1e860bc6d0fbdb0b", n_hits=len(hits),
+               n_violations=len(bad), n_preexisting=len(hits) - len(bad), hits=hits)
+    out = json.dumps(rep, ensure_ascii=False, indent=1)
+    if a.json:
+        Path(a.json).write_text(out, encoding="utf-8")
+    print(out)
+    if bad:
+        raise SystemExit(1)
+
+
+if __name__ == "__main__":
+    main()
