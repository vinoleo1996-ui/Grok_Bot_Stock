+    def blocked(t, j, side):
+        px = rO[t, j] if pol.fill == "next_open" else rC[t, j]
+        if SUS[t, j] or after[t, j] or not np.isfinite(C[t, j]) or not np.isfinite(px):
+            return "HALT_BLOCKED"
