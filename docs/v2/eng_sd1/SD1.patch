+def sha_file(p) -> str:
+    h = hashlib.sha256()
+    with open(ROOT / p, "rb") as fh:
+        for b in iter(lambda: fh.read(1 << 20), b""):
+            h.update(b)
+    return h.hexdigest()
+
+
+def _refuse(msg):
+    raise SystemExit(f"REFUSED (sd0_parity_runner): {msg}")
+
