+        return "LIMIT_BLOCKED" if one else None
+
+    post = np.zeros(m)
+    ret, gross, TO = np.zeros(n), np.zeros(n), np.zeros(n)
+    EX = np.zeros((n, m))
+    ar = np.arange(m)
+    for t in range(n):
+        day = str(idx[t].date())
