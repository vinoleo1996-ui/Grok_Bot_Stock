+    info = dict(factor_source=str(tbl), div_source=None, events=0, aligned_to_jump=0, no_jump=0, shifted=0)
+    dp = Path(div_path) if div_path else _FUND_DIV
+    if dp.is_file() and len(idx):
+        dv = pd.read_parquet(dp)
