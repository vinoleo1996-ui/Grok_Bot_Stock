+    sig_state = {"tgt": None, "fresh": False}
+    cash_hold: list = []   # A2 open BLOCKED_BUDGET_CASH_HELD spells (cash mode)
+
+    def _close_cash_hold(t_end, end_label):
+        for h in cash_hold:
