+def test_only_pinned_project_modules_loaded():
+    allowed = TEST_MODULES | {str(Path(__file__).resolve().relative_to(ROOT))}
+    loaded = set()
+    for mm in list(sys.modules.values()):
+        f = getattr(mm, "__file__", None)
