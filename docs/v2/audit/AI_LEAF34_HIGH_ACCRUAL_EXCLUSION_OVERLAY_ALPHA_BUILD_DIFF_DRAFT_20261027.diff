+def _cross_section_mask(accrual, top_q: float = TOP_Q):
+    import numpy as np
+    import pandas as pd
+
+    df = accrual.copy()
+    if df.empty:
+        return df
+    q = float(top_q)
+    if not (0.0 < q < 1.0):
+        raise SystemExit(f"STOP: top_q must be in (0,1); got {q}")
+    thr = float(df["accrual_cf"].quantile(1.0 - q))
+    df["mask"] = np.where(df["accrual_cf"] >= thr, 0.0, 1.0)
+    # alpha for overlap continuity with COUNT; NOT CFACC TopN main (C11)
+    df["alpha"] = -df["accrual_cf"].astype(float)
+    df["mask_threshold"] = thr
+    return df
