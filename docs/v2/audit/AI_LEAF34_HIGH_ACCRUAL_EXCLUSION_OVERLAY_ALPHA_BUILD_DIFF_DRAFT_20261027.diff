+def _load_ocf_one_day(ocf_path: Path, day, members: set[str]):
+    """Lazy load one rebal day's OCF PIT rows; filter PIT + C3 valid."""
+    import numpy as np
+    import pandas as pd
+    import pyarrow.parquet as pq
+
+    if not ocf_path.is_file():
+        raise SystemExit(f"STOP: PIN_GAP ocf daily missing {ocf_path}")
+    d = pd.Timestamp(day).normalize()
+    cols = [
+        "trade_date", "ts_code", "ocf_to_profit", "net_profit",
+        "denom_small", "np_negative", "period_basis", "e_available_at",
+    ]
+    tab = pq.read_table(
+        ocf_path,
+        columns=cols,
+        filters=[
+            ("trade_date", ">=", d.to_datetime64()),
+            ("trade_date", "<=", d.to_datetime64()),
+        ],
+    )
+    df = tab.to_pandas()
+    if df.empty:
+        return df
+    df["trade_date"] = pd.to_datetime(df["trade_date"]).dt.normalize()
+    df["ts_code"] = df["ts_code"].map(to_ts)
+    df = df[df["ts_code"].isin(members)].copy()
+    if df.empty:
+        return df
+    eav = _as_naive_norm_series(df["e_available_at"])
+    df = df[eav.notna() & (eav <= d)].copy()
+    if df.empty:
+        return df
+    pb = df["period_basis"]
+    pb_ok = pb.astype(str).isin(ACCEPTED_PERIOD_BASIS) | (
+        pb.astype(str).str.contains("YTD", case=False, na=False)
+    )
+    df = df[pb_ok].copy()
+    ocf = df["ocf_to_profit"].astype(float)
+    npv = df["net_profit"].astype(float)
+    denom_small = df["denom_small"].fillna(True).astype(bool)
+    np_neg = df["np_negative"].fillna(True).astype(bool)
+    valid = (
+        ocf.notna()
+        & np.isfinite(ocf.to_numpy())
+        & (~denom_small)
+        & (npv > 0)
+        & (~np_neg)
+    )
+    df = df[valid].copy()
+    if df.empty:
+        return df
+    df["accrual_cf"] = 1.0 - df["ocf_to_profit"].astype(float)
+    df = df.sort_values(["ts_code"]).drop_duplicates("ts_code", keep="last")
+    return df[["ts_code", "accrual_cf", "ocf_to_profit", "net_profit", "period_basis"]]
