+def sw_l1_asof_chunked(sw: pd.DataFrame, keys: pd.DataFrame, code_col: str = "instrument",
+                       sess_col: str = "session", stats: dict | None = None, *,
+                       cal: TradeCal | None = None, on_overlap: str = "raise",
+                       max_keys: int | None = None) -> pd.Series:
+    """r3c (Arch 016ae55e P3-6): sw_l1_asof_with_gap_carry split into whole-session chunks of <= max_keys
+    (default MAX_KEYS_PER_CALL) keys. Same values as one call (rule is per (code, d)); stats: n_* row counts summed,
+    overlap_codes / gap_carry_multi_candidate_codes re-merged by code (their n_codes_* recomputed), other fields
+    from the chunks (identical), plus n_chunks. A single session with > max_keys keys -> SwPitIntegrityError.
+    "raise" mode raises on the first chunk that has an overlap / multi-candidate key."""
+    lim = MAX_KEYS_PER_CALL if max_keys is None else int(max_keys)
+    if lim < 1:
+        raise ValueError(f"max_keys must be >= 1, got {max_keys!r}")
+    if len(keys) <= lim:
+        r = sw_l1_asof_with_gap_carry(sw, keys, code_col, sess_col, stats=stats, cal=cal, on_overlap=on_overlap)
+        if stats is not None:
+            stats["n_chunks"] = 1
+        return r
+    if "_ord" not in sw.columns:
+        sw = prep_sw(sw)
+    sess = keys[sess_col].astype(str).str[:10]
+    sizes = sess.value_counts(sort=False).sort_index()
+    if int(sizes.max()) > lim:
+        raise SwPitIntegrityError(f"sw_l1_asof_chunked: session {sizes.idxmax()} alone has {int(sizes.max())} keys "
+                                  f"> max_keys={lim}")
+    groups: list = []
+    cur: list = []
+    n = 0
+    for s_, c in sizes.items():
+        if cur and n + int(c) > lim:
+            groups.append(cur)
+            cur, n = [], 0
+        cur.append(s_)
+        n += int(c)
+    groups.append(cur)
+    out = np.full(len(keys), None, dtype=object)
+    sts: list = []
+    for g in groups:
+        mask = sess.isin(set(g)).to_numpy()
+        st: dict = {}
+        out[mask] = sw_l1_asof_with_gap_carry(sw, keys[mask], code_col, sess_col, stats=st, cal=cal,
+                                              on_overlap=on_overlap).to_numpy()
+        sts.append(st)
+    if stats is not None:
+        for st in sts:
+            for k, v in st.items():
+                if k in _CODE_LISTS or k in _CODE_LISTS.values():
+                    continue
+                if k.startswith("n_") and isinstance(v, int) and not isinstance(v, bool):
+                    stats[k] = stats.get(k, 0) + v
+                else:
+                    stats.setdefault(k, v)
+        for lk, nk in _CODE_LISTS.items():
+            if any(lk in st for st in sts):
+                stats[lk] = _merge_code_lists([st.get(lk, []) for st in sts])
+                stats[nk] = len(stats[lk])
+        stats["n_chunks"] = len(groups)
+    return pd.Series(out, index=keys.index, name="l1_name")
