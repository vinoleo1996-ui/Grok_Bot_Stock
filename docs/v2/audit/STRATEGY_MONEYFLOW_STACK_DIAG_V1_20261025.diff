+def normalize_code(x: str) -> str:
+    """Bare 6-digit (or raw) code for strip matching: 'sh.510300'/'510300.SH'/'510300' -> '510300'."""
+    s = str(x).strip()
+    if not s:
+        return s
+    if "." in s:
+        a, b = s.split(".", 1)
+        if a.lower() in ("sh", "sz", "bj"):
+            return b
+        return a  # CODE.MKT
+    return s
+
+
+def void(out: Path, msg: str) -> None:
