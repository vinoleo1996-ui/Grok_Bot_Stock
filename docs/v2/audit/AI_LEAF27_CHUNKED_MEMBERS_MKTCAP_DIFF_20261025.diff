+def _check_rss(stage: str) -> float:
+    r = rss_mb()
+    if r > RSS_LIMIT_MB:
+        raise SystemExit(
+            f"ABORT_RSS_OVER_LIMIT stage={stage} rss={r:.0f}MB "
+            f"limit={RSS_LIMIT_MB} (forbid raise; chunked r1 soft gate)"
+        )
+    return r
