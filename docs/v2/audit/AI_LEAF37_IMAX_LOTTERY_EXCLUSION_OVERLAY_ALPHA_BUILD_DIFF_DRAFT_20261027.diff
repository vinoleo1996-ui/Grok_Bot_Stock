+def _cross_section_mask_imax(cs, top_q: float = TOP_Q):
+    import numpy as np
+
+    df = cs.copy()
+    if df.empty:
+        return df
+    q = float(top_q)
+    if not (0.0 < q < 1.0):
+        raise SystemExit(f"STOP: top_q must be in (0,1); got {q}")
+    thr = float(df["imax_proxy"].quantile(1.0 - q))
+    df["mask"] = np.where(df["imax_proxy"] >= thr, 0.0, 1.0)
+    df["alpha"] = -df["imax_proxy"].astype(float)
+    df["mask_threshold"] = thr
+    return df
