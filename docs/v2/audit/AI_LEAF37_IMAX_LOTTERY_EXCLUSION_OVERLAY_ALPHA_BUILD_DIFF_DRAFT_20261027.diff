+        f"soft={soft_kb} split={split_kb} c4={c4_kb} hard={hard_kb}",
+        flush=True,
+    )
+    if pk >= hard_kb or (vr is not None and vr >= hard_kb):
+        print(
+            f"STOP: RSS hard breached peak_kb={pk} vmrss={vr} >= hard={hard_kb}",
+            file=sys.stderr,
