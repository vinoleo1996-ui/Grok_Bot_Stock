+def ols_resid(y, X):
+    import numpy as np
+
+    b, *_ = np.linalg.lstsq(X, y, rcond=None)
+    return y - X @ b
+
+
+def spearman_rho(a, b) -> float:
+    import numpy as np
+    import pandas as pd
+
+    if len(a) < 5:
+        return float("nan")
+    ra = pd.Series(a).rank().to_numpy()
+    rb = pd.Series(b).rank().to_numpy()
+    if np.nanstd(ra) == 0 or np.nanstd(rb) == 0:
+        return float("nan")
+    return float(np.corrcoef(ra, rb)[0, 1])
+
+
+def exclusion_jaccard(excl_a: set, excl_b: set) -> float:
+    u = excl_a | excl_b
+    if not u:
+        return float("nan")
+    return float(len(excl_a & excl_b) / len(u))
+
+
+def rolling_imax(arr, win: int = IMAX_WIN, k: int = IMAX_K_MAX, min_valid: int = IMAX_MIN_VALID):
+    """IMAX_proxy = mean(largest k finite in trailing win); NaN if <min_valid."""
+    import numpy as np
+
+    n = len(arr)
+    out = np.full(n, np.nan)
+    for i in range(n):
+        s = max(0, i - win + 1)
+        w = arr[s : i + 1]
+        w = w[np.isfinite(w)]
+        if len(w) < min_valid:
+            continue
+        out[i] = (
+            float(np.mean(np.partition(w, -k)[-k:])) if len(w) >= k else float(np.mean(w))
+        )
+    return out
+
+def _load_mask_members(mask_path: Path, start: str, end: str, *, label: str):
