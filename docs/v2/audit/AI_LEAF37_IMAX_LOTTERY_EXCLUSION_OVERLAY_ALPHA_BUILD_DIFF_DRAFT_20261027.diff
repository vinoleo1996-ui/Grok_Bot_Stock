+    if label == "HILIQ" and meta["mask_sha8"] != HI_LIQ_MASK_SHA8_PIN:
+        print(
+            f"WARN: HI_LIQ mask sha8={meta['mask_sha8']} != pin {HI_LIQ_MASK_SHA8_PIN}",
