+def write_overlap_report(
+    alpha_df,
+    out_path: Path,
+    paths: dict[str, Path],
+    leaf24_dir: Path,
+    sample_n: int = 6,
+) -> dict:
+    """C7: exclusion-set Jaccard + Spearman rho vs hard/disclose targets."""
+    import numpy as np
+    import pandas as pd
+
+    alpha_df = alpha_df.copy()
+    alpha_df["trade_date"] = pd.to_datetime(alpha_df["trade_date"])
+    days = sorted(alpha_df["trade_date"].unique())
+    if not days:
+        payload = {
+            "error": "empty_alpha",
+            "schema": "leaf37_overlap_vs_leaf18_18v_27_hard_24_34_35_36_disclose",
+        }
+        out_path.write_text(json.dumps(payload, indent=2, ensure_ascii=False) + "\n")
+        return payload
+    rebal = days[::REBAL_EVERY]
+    if rebal[-1] != days[-1]:
+        rebal = list(rebal) + [days[-1]]
+    if len(rebal) <= sample_n:
+        sample = list(rebal)
+    else:
+        idxs = np.linspace(0, len(rebal) - 1, sample_n)
+        sample = []
+        seen = set()
+        for i in idxs:
+            d = rebal[int(round(i))]
+            if d not in seen:
+                sample.append(d)
+                seen.add(d)
+    sample = sorted(sample)
+
