+def _soft_penalty_resid(df):
+    """Soft-penalty on -IMAX_proxy (NON PRIMARY). Requires SW+logmv+style."""
+    import numpy as np
+    import pandas as pd
+
+    df = df.copy()
+    df["y"] = -df["imax_proxy"].astype(float)
+    out_rows = []
+    for sw, g in df.groupby("sw_code"):
+        g = g.copy()
+        if len(g) < 5:
+            g["soft_penalty"] = g["y"] - g["y"].mean()
+            out_rows.append(g)
+            continue
+        g["y"] = g["y"] - g["y"].mean()
+        X = np.column_stack(
+            [
+                np.ones(len(g)),
+                g["logmv"].to_numpy(float),
+                g["mom20"].to_numpy(float),
+                g["vol20"].to_numpy(float),
+                g["logADV20"].to_numpy(float),
+            ]
+        )
+        if not np.isfinite(X).all() or not np.isfinite(g["y"].to_numpy(float)).all():
+            continue
+        resid = ols_resid(g["y"].to_numpy(float), X)
+        g["soft_penalty"] = resid
+        out_rows.append(g)
+    if not out_rows:
+        return df.iloc[0:0]
+    return pd.concat(out_rows, ignore_index=True)
+
+def _load_other_alpha(path: Path, sample_dates: list):
+    """Load alpha/score on sample dates. Supports alpha parquet or exclusion mask."""
+    import numpy as np
+    import pandas as pd
+    import pyarrow as pa
+    import pyarrow.parquet as pq
+
+    if not path.is_file():
+        return None
+    schema = pq.read_schema(path)
+    names = set(schema.names)
+    if "trade_date" in names and "ts_code" in names:
+        date_col, inst_col = "trade_date", "ts_code"
+    elif "date" in names and "instrument" in names:
+        date_col, inst_col = "date", "instrument"
+    else:
+        return None
+    field = schema.field(date_col)
+    is_str = pa.types.is_string(field.type) or pa.types.is_large_string(field.type)
+    if "mask" in names and "alpha" not in names:
+        cols = [date_col, inst_col, "mask"]
+        if is_str:
+            dmin = min(sample_dates).strftime("%Y-%m-%d")
+            dmax = max(sample_dates).strftime("%Y-%m-%d")
+            t = pq.read_table(
+                path, columns=cols,
+                filters=[(date_col, ">=", dmin), (date_col, "<=", dmax)],
+            )
+        else:
+            t = pq.read_table(
+                path, columns=cols,
+                filters=[
+                    (date_col, ">=", min(sample_dates).to_datetime64()),
+                    (date_col, "<=", max(sample_dates).to_datetime64()),
+                ],
+            )
+        df = t.to_pandas()
+        df[date_col] = pd.to_datetime(df[date_col])
+        want = set(pd.Timestamp(d) for d in sample_dates)
+        df = df[df[date_col].isin(want)].copy()
+        df.rename(columns={date_col: "date", inst_col: "instrument"}, inplace=True)
+        df["instrument"] = df["instrument"].map(to_ts)
+        df["score"] = -df["mask"].astype(float)
+        df["excl_flag"] = (df["mask"].astype(float) == 0.0).astype(int)
+        return df
+    if "alpha" not in names:
+        return None
+    cols = [date_col, inst_col, "alpha"]
+    if is_str:
+        dmin = min(sample_dates).strftime("%Y-%m-%d")
+        dmax = max(sample_dates).strftime("%Y-%m-%d")
+        t = pq.read_table(
+            path, columns=cols,
+            filters=[(date_col, ">=", dmin), (date_col, "<=", dmax)],
+        )
+    else:
+        t = pq.read_table(
+            path, columns=cols,
+            filters=[
+                (date_col, ">=", min(sample_dates).to_datetime64()),
+                (date_col, "<=", max(sample_dates).to_datetime64()),
+            ],
+        )
+    df = t.to_pandas()
+    df[date_col] = pd.to_datetime(df[date_col])
+    want = set(pd.Timestamp(d) for d in sample_dates)
+    df = df[df[date_col].isin(want)].copy()
+    df.rename(
+        columns={date_col: "date", inst_col: "instrument", "alpha": "score"},
+        inplace=True,
+    )
+    df["instrument"] = df["instrument"].map(to_ts)
+    df["excl_flag"] = np.nan
+    return df
+
