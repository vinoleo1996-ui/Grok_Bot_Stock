+    end_ts = pd.Timestamp(end)
+    tab = pq.read_table(
+        mask_path,
+        columns=["date", "instrument", "in_universe"],
+        filters=[
+            ("date", ">=", start_ts),
+            ("date", "<=", end_ts),
+            ("in_universe", "==", True),
