+def _load_panel_imax(panel_dir: Path, by_day: dict, *, rss_cb=None):
+    """Load panel ret/ret_on; compute r_id + IMAX_proxy on HI_LIQ members."""
+    import numpy as np
+    import pandas as pd
+    import pyarrow.parquet as pq
+
+    cols = ["date", "instrument", "hiliq", "ret", "ret_on"]
+    frames = []
+    panel_sha = {}
+    for y in (2023, 2024, 2025, 2026):
+        p = panel_dir / f"cs_panel_{y}.parquet"
+        if not p.is_file():
+            raise SystemExit(f"STOP: PIN_GAP panel missing {p}")
+        panel_sha[str(y)] = sha256_file(p)[:8]
+        pin = PANEL_SHA8_PIN.get(str(y))
+        if pin and panel_sha[str(y)] != pin:
+            print(
+                f"WARN: panel {y} sha8={panel_sha[str(y)]} != pin {pin}",
+                file=sys.stderr,
+            )
+        frames.append(pq.read_table(p, columns=cols).to_pandas())
+    panel = pd.concat(frames, ignore_index=True)
+    del frames
+    gc.collect()
+    if rss_cb:
+        rss_cb("after_panel_concat")
+    panel["date"] = pd.to_datetime(panel["date"]).dt.normalize()
+    panel["instrument"] = panel["instrument"].map(to_ts)
+    warm_lo = pd.Timestamp(WARM_START)
+    x2_hi = pd.Timestamp(X2_END)
+    panel = panel[(panel["date"] >= warm_lo) & (panel["date"] <= x2_hi)].copy()
+    key = (
+        pd.DataFrame(
+            [(d, c) for d, mems in by_day.items() for c in mems],
+            columns=["date", "instrument"],
+        )
+        .drop_duplicates()
+        .assign(in_hiliq=True)
+    )
+    key["date"] = pd.to_datetime(key["date"]).dt.normalize()
+    panel = panel.merge(key, on=["date", "instrument"], how="left")
+    panel["in_hiliq"] = panel["in_hiliq"].fillna(False)
+    if panel["hiliq"].dtype == bool:
+        panel["in_hiliq"] = panel["in_hiliq"] & panel["hiliq"].fillna(False)
+    ret = panel["ret"].astype(float)
+    ron = panel["ret_on"].astype(float)
+    panel["r_id"] = (1.0 + ret) / (1.0 + ron) - 1.0
+    panel.loc[ret.isna() | ron.isna() | ~np.isfinite(panel["r_id"]), "r_id"] = np.nan
+    sub = panel.loc[
+        panel["in_hiliq"] & panel["r_id"].notna(), ["date", "instrument", "r_id"]
+    ]
+    del panel
+    gc.collect()
+    if rss_cb:
+        rss_cb("after_r_id")
+    piv = sub.pivot_table(
+        index="date", columns="instrument", values="r_id", aggfunc="last"
+    ).sort_index()
+    del sub
+    gc.collect()
+    imax_cols = {c: rolling_imax(piv[c].to_numpy(dtype=float)) for c in piv.columns}
+    imax = pd.DataFrame(imax_cols, index=piv.index)
+    del piv, imax_cols
+    gc.collect()
+    if rss_cb:
+        rss_cb("after_panel_imax")
+    long = imax.stack(future_stack=True).rename("imax_proxy").reset_index()
+    long.columns = ["date", "instrument", "imax_proxy"]
+    long["date"] = pd.to_datetime(long["date"]).dt.normalize()
+    long["instrument"] = long["instrument"].map(to_ts)
+    return long, panel_sha
+
