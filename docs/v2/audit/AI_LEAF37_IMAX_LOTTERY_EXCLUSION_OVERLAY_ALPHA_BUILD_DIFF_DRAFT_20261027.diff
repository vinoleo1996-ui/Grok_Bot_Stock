+    by_day: dict = {}
+    for d, g in df.groupby("date", sort=True):
+        by_day[pd.Timestamp(d)] = sorted(set(g["instrument"].tolist()))
+    codes = sorted({c for v in by_day.values() for c in v})
+    meta = {
