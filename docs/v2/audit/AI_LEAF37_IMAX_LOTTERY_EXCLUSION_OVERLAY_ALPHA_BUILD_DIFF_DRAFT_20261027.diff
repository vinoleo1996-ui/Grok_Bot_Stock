+def assert_tmp_quantlab(path: Path, what: str) -> None:
+    resolved = path.resolve()
+    parts = resolved.parts
+    ok = False
+    if len(parts) >= 3 and parts[1] == "tmp":
+        name = parts[2]
+        if name.startswith("quantlab"):
