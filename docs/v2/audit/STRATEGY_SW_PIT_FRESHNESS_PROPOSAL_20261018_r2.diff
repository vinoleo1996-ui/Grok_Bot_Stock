+"""SW PIT (data/v2/sw_pit) freshness self-check — 主 Agent 2026-10-18 05:06 ET ruling; Arch review ccc7546f (r2).
+
+Consumers of sw_pit must check the table themselves; freshness overall=ok does NOT cover sw_pit.
+Freshness is judged by manifest `built` only (directory mtimes are unreliable).
+- Integrity failures RAISE (stop): manifest unreadable, parquet missing, sha256 != manifest.
+- Staleness WARNS (run with disclosure): built older than STALE_BUILT_MAX_DAYS; as_of (last rebalance date) later than built date -> coverage_gap.
+Read-only. Result is cached per (level) for the process; first call does the check.
+"""
+from __future__ import annotations
+
+import datetime as _dt
+import hashlib
+import json
+from pathlib import Path
+
+STALE_BUILT_MAX_DAYS = 3  # warn only (Arch r2 ruling)
+_CACHE: dict = {}
+
+
+class SwPitIntegrityError(RuntimeError):
+    pass
+
+
+def check_sw_pit(root: Path, level: str = "l1", as_of: str | None = None,
+                 today: _dt.date | None = None) -> dict:
+    today = today or _dt.date.today()
+    mpath = root / "data/v2/sw_pit/manifest.json"
+    try:
+        man = json.loads(mpath.read_text(encoding="utf-8"))
+    except Exception as e:
+        raise SwPitIntegrityError(f"sw_pit manifest unreadable: {mpath} ({type(e).__name__}: {e})")
+    fpath = root / "data/v2/sw_pit" / f"industry_members_sw_{level}_pit.parquet"
+    if not fpath.exists():
+        raise SwPitIntegrityError(f"sw_pit parquet missing: {fpath}")
+    actual = hashlib.sha256(fpath.read_bytes()).hexdigest()
+    listed = (man.get("sha256") or {}).get(f"sw_pit/{fpath.name}")
+    if listed != actual:
+        raise SwPitIntegrityError(f"sw_pit sha mismatch: actual={actual} manifest={listed}")
+    built = man.get("built")
+    if not built:
+        raise SwPitIntegrityError("sw_pit manifest has no 'built'")
+    built_d = _dt.date.fromisoformat(str(built)[:10])
+    rng = (man.get(level) or {}).get("in_date_range") or [None, None]
+    warns = []
+    age = (today - built_d).days
+    if age > STALE_BUILT_MAX_DAYS:
+        warns.append(f"built_age_days={age}>{STALE_BUILT_MAX_DAYS}")
+    if as_of is not None and _dt.date.fromisoformat(str(as_of)[:10]) > built_d:
+        warns.append(f"coverage_gap: as_of={str(as_of)[:10]} > built={built_d.isoformat()}")
+    out = {"manifest": "data/v2/sw_pit/manifest.json", "level": level, "checked_on": today.isoformat(),
+           "as_of": None if as_of is None else str(as_of)[:10], "built": built, "built_age_days": age,
+           "in_date_range": rng, "in_date_max": rng[-1], "sha256": actual,
+           "promotion_approved": man.get("promotion_approved"),
+           "stale": bool(warns), "warns": warns,
+           "disclosure_zh": ("【披露】申万 sw_pit 表可能过期：" + "；".join(warns) +
+                             f"（built={built}，in_date 最大 {rng[-1]}）。行业相关结果仅作带披露参考。")
+           if warns else ""}
+    print("[sw_pit_freshness]", json.dumps(out, ensure_ascii=False))
+    return out
+
+
+def ensure_checked(root: Path, level: str = "l1", as_of: str | None = None) -> dict:
+    """Check once per process (first caller's as_of wins); later calls return the cached result."""
+    if level not in _CACHE:
+        _CACHE[level] = check_sw_pit(root, level=level, as_of=as_of)
+    return _CACHE[level]
+
+
+def last_result(level: str = "l1") -> dict | None:
+    return _CACHE.get(level)
