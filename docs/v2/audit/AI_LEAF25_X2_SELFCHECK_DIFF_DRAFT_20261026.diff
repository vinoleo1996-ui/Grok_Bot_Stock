+IND_CAP = {"HILIQ": 0.25, "FULLA": 0.28}
+RSS_SOFT_MB = 1500  # 软/硬同钉；禁抬
+RSS_HARD_MB = 1500
+PEAK_PROOF_REQUIRED = True
+SAMPLER_PREFIX = "/tmp/quantlab_leaf25_x2_selfcheck_"
+PROPOSED_OK = "output/ai_factory/ARCH_RUN_AUTH_LEAF25_X2_SELFCHECK_V2_HILIQ_X2.ok"
+FORBID_RESTORED = (
+    "e107383f",
+    "2be59acd",
+    "a7d98ac9",
+    "8e51de63",
+    "3a6caa4f",
+    "8bcd79dc",
+    "725be3e0",
+    "0f50daf7",
+    "3c19dd7d",
+    "1c32ab1e",
+    "6054b3bf",
+    "3c297052",  # 叶25 alpha 构建 CONSUMED 内容；禁 RESTORED
+)
+PIN_GAP_FIELDS = ("beta120", "mom", "logADV20", "vol20")
