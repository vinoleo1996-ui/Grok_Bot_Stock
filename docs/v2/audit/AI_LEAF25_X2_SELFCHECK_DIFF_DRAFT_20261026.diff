+        "forbid_raise_rss": True,
+        "universe": "HILIQ",
+        "window": "x2",
+        "pin_alpha": str(PIN_ALPHA),
+        "pin_alpha_sha256": PIN_ALPHA_SHA,
+        "pin_meta_sha256": PIN_META_SHA,
+        "build_script_sha8_unchanged": BUILD_SCRIPT_SHA8,
