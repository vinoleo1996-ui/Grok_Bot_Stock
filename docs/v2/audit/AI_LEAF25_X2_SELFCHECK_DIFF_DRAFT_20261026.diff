+
+# --- 硬钉（PRIMARY HILIQ × x2；叶25 全叶 alpha 构建 CONSUMED 产物）---
+PIN_ALPHA = (
+    ROOT
+    / "output/ai_factory/_leaf25_full_factor/20261026_015610/alpha_HILIQ_x2_20261026_125138.parquet"
+)
+PIN_META = ROOT / "output/ai_factory/_leaf25_full_factor/20261026_015610/run_meta.json"
+PIN_ALPHA_SHA = "8be12024f57fc85833d99e44f94f5c2916b1aaab64f037eed223f0fc61792393"
+PIN_META_SHA = "44c27f5467420861b2c28a6b0311674c06b69fe8d051fbc256ce31cd7bc7d7e9"
+BUILD_SCRIPT_SHA8 = "de7b3647"  # research/leaf25_full_factor_alpha_build_r1.py UNCHANGED
+
+OUT_DIR = ROOT / "output/ai_factory/_leaf25_full_factor/20261026_015610"
+SELFCHECK_SUB = OUT_DIR / "_selfcheck"
+REPORT_DIR = ROOT / "output/ai_factory/leaf_reports/leaf25_full_factor"
+SW_L1_PATH = ROOT / "data/v2/sw_l1_pit/industry_members_sw_l1_tushare.parquet"
+
+BALLAST = "510300.SH"
+HARD_EXCLUDE = frozenset({"600519.SH", "002371.SZ"})
+NAME_W = 0.04
+MAX_NAMES = 20
