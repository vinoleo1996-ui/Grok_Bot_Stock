+def _t_ts_1500(day):
+    """PRIMARY PIT decision timestamp: t-day 15:00 Asia/Shanghai (naive local)."""
+    import pandas as pd
+
+    d = pd.Timestamp(day).normalize()
+    return d + pd.Timedelta(hours=15)
