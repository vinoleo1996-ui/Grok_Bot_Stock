+def stop_rule_eval(disc, x2_only):
+    """Evaluate-only for this research run: reports where the frozen rule WOULD stop; never alters any decision or target."""
+    res = {}
+    d0 = disc if not x2_only else disc[disc["date"] >= X2[0]]
