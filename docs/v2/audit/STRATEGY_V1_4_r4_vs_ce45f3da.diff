+def write_x_atomic(path, text):
+    """r3 (Arch P3-2): write <path>.tmp exclusively, then os.link to <path> (fails if <path> exists), then drop the tmp.
+    The final name appears only complete; nothing is ever replaced."""
+    tmp = path.with_name(path.name + ".tmp")
