+def check_interpreter(kv, environ=None):
+    """Arch P2-2 + r3 (Arch §7 item 2 / P3-5): realpath(sys.executable) == realpath(python_exe); python_exe must be a venv
+    interpreter (<venv>/pyvenv.cfg MUST exist) and sys.prefix must be that venv (.venv_opt/bin/python is a symlink to
+    /usr/bin/python3.13, so realpath alone cannot tell the venv from the bare system interpreter); PYTHONPATH / PYTHONHOME /
+    PYTHONSTARTUP / PYTHONUSERBASE must be unset or empty; numpy / pandas / pyarrow / cvxpy must be loaded from under sys.prefix."""
