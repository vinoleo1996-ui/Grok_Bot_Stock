+    evald = [x for x in out["attempts"] if x["w"] is not None and x["K"] >= sel["K"] and x["hard_both"]]
+    if evald:
+        out["adopt"] = min(evald, key=lambda x: (x["K"], x["attempt"])); return out
+    out["fail_stage"] = "lot"; return out
