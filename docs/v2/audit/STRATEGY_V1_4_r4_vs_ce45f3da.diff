+def acquire_lock(path, payload):
+    """Arch P2-4: O_CREAT|O_EXCL lock outside the out dir; never removed by code (kept as the run record, Arch archives it)."""
+    try:
+        fd = os.open(str(path), os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o444)
+    except FileExistsError:
