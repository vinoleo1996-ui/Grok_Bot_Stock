+def _as_naive_norm_ts(x):
+    """Align one Timestamp/datetime to tz-naive calendar day.
+
+    Strategy (LOCKED this patch): naive_calendar_day.
+    If tz-aware → tz_convert("Asia/Shanghai") → tz_localize(None) → normalize().
+    If already naive → normalize(). NaT stays NaT.
+    """
+    import pandas as pd
+
+    if x is None:
+        return pd.NaT
+    try:
+        if pd.isna(x):
+            return pd.NaT
+    except (TypeError, ValueError):
+        pass
+    ts = pd.Timestamp(x)
+    if pd.isna(ts):
+        return pd.NaT
+    if ts.tzinfo is not None:
+        ts = ts.tz_convert("Asia/Shanghai").tz_localize(None)
+    return ts.normalize()
+
+
+def _as_naive_norm_series(s):
+    """Align a datetime Series to tz-naive calendar days (same strategy as _as_naive_norm_ts).
+
+    Fast path for DatetimeTZDtype / naive datetime64; object/mixed → elementwise
+    (avoids pandas coercing naive→NaT when mixed with tz-aware in one Series).
+    """
+    import pandas as pd
+
+    s = pd.Series(s)
+    if isinstance(s.dtype, pd.DatetimeTZDtype):
+        return s.dt.tz_convert("Asia/Shanghai").dt.tz_localize(None).dt.normalize()
+    if pd.api.types.is_datetime64_dtype(s.dtype):
+        return pd.to_datetime(s, errors="coerce").dt.normalize()
+    # object / mixed / strings
+    return pd.to_datetime(s.map(_as_naive_norm_ts), errors="coerce")
+
+
+
