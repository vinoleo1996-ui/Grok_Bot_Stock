+"""SW PIT (data/v2/sw_pit) freshness self-check — 主 Agent 2026-10-18 05:06 ET ruling.
+
+Consumers of sw_pit must check the table themselves before use; freshness overall=ok does NOT cover sw_pit.
+Read-only: reads manifest.json and hashes the parquet. Never raises on staleness; returns a disclosure dict
+that the caller prints and writes into its run receipt (stale -> disclosure label, not a silent pass).
+"""
+from __future__ import annotations
+
+import datetime as _dt
+import hashlib
+import json
+from pathlib import Path
+
+STALE_BUILT_MAX_DAYS = 3  # DRAFT threshold, pending Arch ruling
+
+
+def check_sw_pit(root: Path, level: str = "l1", today: _dt.date | None = None) -> dict:
+    today = today or _dt.date.today()
+    mpath = root / "data/v2/sw_pit/manifest.json"
+    out: dict = {"manifest": str(mpath.relative_to(root)), "level": level, "checked_on": today.isoformat()}
+    try:
+        man = json.loads(mpath.read_text(encoding="utf-8"))
+    except Exception as e:  # missing / malformed manifest -> stale with reason
+        out.update(stale=True, reasons=[f"manifest_unreadable:{type(e).__name__}"])
+        return out
+    lv = man.get(level, {})
+    fpath = root / "data/v2/sw_pit" / f"industry_members_sw_{level}_pit.parquet"
+    rel = f"sw_pit/{fpath.name}"
+    actual = hashlib.sha256(fpath.read_bytes()).hexdigest() if fpath.exists() else None
+    listed = (man.get("sha256") or {}).get(rel)
+    built = man.get("built")
+    rng = lv.get("in_date_range") or [None, None]
+    reasons = []
+    built_age = None
+    if built:
+        built_age = (today - _dt.date.fromisoformat(str(built)[:10])).days
+        if built_age > STALE_BUILT_MAX_DAYS:
+            reasons.append(f"built_age_days={built_age}>{STALE_BUILT_MAX_DAYS}")
+    else:
+        reasons.append("built_missing")
+    if actual is None:
+        reasons.append("parquet_missing")
+    elif listed != actual:
+        reasons.append("sha_mismatch_vs_manifest")
+    out.update(built=built, built_age_days=built_age, in_date_range=rng, in_date_max=rng[-1],
+               sha256_actual=actual, sha256_manifest=listed,
+               promotion_approved=man.get("promotion_approved"),
+               stale=bool(reasons), reasons=reasons,
+               disclosure_zh=("申万 sw_pit 表可能过期：" + "；".join(reasons) +
+                              f"（built={built}，in_date 最大 {rng[-1]}）。行业相关结果仅作带披露参考。")
+               if reasons else "")
+    print("[sw_pit_freshness]", json.dumps(out, ensure_ascii=False))
+    return out
