+"""SW L1 membership as-of (point-in-time) lookup — fixes static "last known l1_name" look-ahead (Arch 10-18 P2).
+
+口径对齐 Intel sw_members_asof (a5b0b633/0e968759)，两边落地后合并为公共函数。
+Rule for trading day d: in_date < d AND (out_date is null OR out_date >= d).
+  - in_date is published 18:00 Asia/Shanghai -> usable from the NEXT trading day (in_date == d excluded).
+  - out_date known only after the close -> still a member on out_date (out_date == d included).
+Dates are normalized to midnight (pd.Timestamp(d).normalize()); unparseable in_date -> NaT -> never matches
+(same as Intel: NaT < d is False); null/unparseable out_date -> NaT -> treated as "still a member".
+Overlap (data error only; a clean reclass has old out_date=d-?, new in_date>=out_date): keep the row with the
+latest in_date, ties -> later file row (Intel industry_stocks uses keep="last" after filtering).
+Read-only; no I/O except load_sw_l1().
+"""
+from __future__ import annotations
+
+from pathlib import Path
+
+import numpy as np
+import pandas as pd
+
+SW_L1_REL = "data/v2/sw_pit/industry_members_sw_l1_pit.parquet"
+
+
+def prep_sw(sw: pd.DataFrame) -> pd.DataFrame:
+    sw = sw.copy()
+    sw["in_date"] = pd.to_datetime(sw["in_date"], errors="coerce").dt.normalize()
+    sw["out_date"] = pd.to_datetime(sw["out_date"], errors="coerce").dt.normalize()
+    sw["_ord"] = np.arange(len(sw))
+    return sw
+
+
+def load_sw_l1(root: Path) -> pd.DataFrame:
+    return prep_sw(pd.read_parquet(Path(root) / SW_L1_REL, columns=["ts_code", "l1_name", "in_date", "out_date"]))
+
+
+def sw_members_asof(sw: pd.DataFrame, d) -> pd.DataFrame:
+    """Identical to Intel intel_common.sw_members_asof (expects datetime in_date/out_date)."""
+    d = pd.Timestamp(d).normalize()
+    return sw[(sw.in_date < d) & (sw.out_date.isna() | (sw.out_date >= d))]
+
+
+def l1_asof(sw: pd.DataFrame, keys: pd.DataFrame, code_col: str = "instrument",
+            sess_col: str = "session") -> pd.Series:
+    """Vectorized as-of l1_name for each (code, session) row of `keys`; index aligned to keys; NaN if no member."""
+    if "_ord" not in sw.columns:
+        sw = prep_sw(sw)
+    k = pd.DataFrame({"_code": keys[code_col].astype(str).values,
+                      "_d": pd.to_datetime(keys[sess_col].astype(str).str[:10]).dt.normalize().values,
+                      "_rid": np.arange(len(keys))})
+    s = sw[["ts_code", "l1_name", "in_date", "out_date", "_ord"]].rename(columns={"ts_code": "_code"})
+    m = k.merge(s, on="_code", how="inner")
+    m = m[(m["in_date"] < m["_d"]) & (m["out_date"].isna() | (m["out_date"] >= m["_d"]))]
+    m = m.sort_values(["_rid", "in_date", "_ord"]).drop_duplicates("_rid", keep="last")
+    out = np.full(len(keys), None, dtype=object)
+    out[m["_rid"].to_numpy()] = m["l1_name"].to_numpy()
+    return pd.Series(out, index=keys.index, name="l1_name")
+
+
+def l1_static_last(sw: pd.DataFrame) -> dict:
+    """Legacy static map (last in_date per code) — look-ahead; kept only for before/after comparison."""
+    if "_ord" not in sw.columns:
+        sw = prep_sw(sw)
+    last = sw.sort_values(["in_date", "_ord"]).groupby("ts_code").tail(1)
+    return dict(zip(last["ts_code"], last["l1_name"]))
+
+
+class IndustryAsOf:
+    """Per-session industry map for hx2.build_topn / apply_ind_cap (which take a plain dict per session)."""
+
+    def __init__(self, sw: pd.DataFrame):
+        self.sw = sw if "_ord" in sw.columns else prep_sw(sw)
+        self.static = l1_static_last(self.sw)
+
+    def by_session(self, pairs: pd.DataFrame, code_col: str = "instrument",
+                   sess_col: str = "session") -> dict:
+        """{session: {code: l1_name}} for the given (code, session) pairs (unique-ified first)."""
+        p = pairs[[code_col, sess_col]].drop_duplicates().reset_index(drop=True)
+        p = p.assign(l1_name=l1_asof(self.sw, p, code_col, sess_col).values).dropna(subset=["l1_name"])
+        return {s: dict(zip(g[code_col], g["l1_name"])) for s, g in p.groupby(sess_col)}
+
+    def reclass_share(self, rows: pd.DataFrame, code_col: str = "instrument", sess_col: str = "session",
+                      weight_col: str | None = None) -> dict:
+        """Disclosure only: share of (session, holding) rows whose as-of l1 != static last-known l1."""
+        if rows.empty:
+            return {"n_rows": 0, "share_rows_diff": None}
+        a = l1_asof(self.sw, rows, code_col, sess_col)
+        st = rows[code_col].astype(str).map(self.static)
+        diff = (a.fillna("_UNK_") != st.fillna("_UNK_"))
+        out = {"n_rows": int(len(rows)), "n_rows_diff": int(diff.sum()), "share_rows_diff": float(diff.mean()),
+               "n_rows_asof_missing": int(a.isna().sum()), "n_rows_static_missing": int(st.isna().sum())}
+        if weight_col:
+            w = rows[weight_col].astype(float)
+            out["share_weight_diff"] = float(w[diff].sum() / w.sum()) if w.sum() > 0 else None
+        return out
