+    # on 2025-03-10 the new row (in_date==d) is not yet usable; the old row (out_date==d) still is
+    assert _q([("X.SZ", "2025-03-10"), ("Z.SH", "2025-03-10"), ("Z.SH", "2025-03-11")]) == ["电子", "医药生物", None]
