+    cannot change results, but its value is recorded in every output."""
+    return {"QL_X2_EXTEND_END": os.environ.get("QL_X2_EXTEND_END"), RLIMIT_ENV: os.environ.get(RLIMIT_ENV),
+            "rlimit_as_kb_effective": rlimit_as_kb()}
