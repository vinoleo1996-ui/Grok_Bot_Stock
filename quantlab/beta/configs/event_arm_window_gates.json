      "kill_on_zero_events": false
    },
    "book_window_explore": {
      "start": "2024-06-03",
      "end": null,
      "role": "book_primary_explore",
      "note": "end=null means latest available session"
    },
    "book_window_dev_sealed": {
      "start": "2018-01-02",
      "end": "2024-05-31",
      "role": "sealed_dev_describe_only",
