+    return {"table": table, "max_date": str(max_date.date()), "built": man["built"],
+            "covered_through": str(cov.date()), "lag_days": lag,
+            "status": "stale" if stale else "ok", "disclosure": disc + ("（STALE）" if stale else "")}
+
