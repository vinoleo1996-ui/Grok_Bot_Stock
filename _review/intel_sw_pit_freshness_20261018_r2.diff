+def check_table_freshness(table: str, asof=None, root: Path | None = None) -> dict:
+    """返回 {table, max_date, built, covered_through, lag_days, status: ok/stale, disclosure}。
+    完整性问题（manifest 缺失或不可读、parquet 缺失、sha256 不一致）抛 TableIntegrityError。
+    max_date = manifest.in_date_range[1]，只代表最后一次成分变动，不单独判过期；
+    built 按美东解释后换算到上海：上海时间 18:00 前构建，只覆盖到前一交易日；否则覆盖当日；
+    lag_days = (covered_through, asof 当日或之前最后一个交易日] 内的交易日数。"""
+    root = Path(root or ROOT)
+    cfg = FRESHNESS_TABLES[table]
+    mp, pq = root / cfg["manifest"], root / cfg["parquet"]
+    try:
+        man = json.loads(mp.read_text())
+    except Exception as e:
+        raise TableIntegrityError(f"{table}: manifest 读不到（{cfg['manifest']}：{type(e).__name__}）")
+    if not pq.exists():
+        raise TableIntegrityError(f"{table}: parquet 缺失（{cfg['parquet']}）")
+    want = (man.get("sha256") or {}).get(cfg["sha_key"])
+    got = _hashlib.sha256(pq.read_bytes()).hexdigest()
+    if not want or want != got:
+        raise TableIntegrityError(f"{table}: sha256 不一致（manifest {str(want)[:12]}… vs 实算 {got[:12]}…）")
+    sub = man.get(cfg["manifest_key"], {})
+    rng = sub.get("in_date_range") or []
+    if len(rng) != 2 or not man.get("built"):
+        raise TableIntegrityError(f"{table}: manifest 缺 in_date_range 或 built")
+    max_date = pd.Timestamp(rng[1])
+    built_et = pd.Timestamp(man["built"]).tz_localize(BUILT_TZ)
+    built_sh = built_et.tz_convert(SH_TZ)
+    asof = pd.Timestamp(asof or datetime.now(ET_TZ).strftime("%Y-%m-%d")).normalize()
+    td = _trading_days(root)
+    last_td = max([d for d in td if d <= asof], default=asof)
+    bd = pd.Timestamp(built_sh.date())
+    cov = bd if (built_sh.hour >= 18 and bd in td) else max([d for d in td if d < bd], default=bd)
+    lag = sum(1 for d in td if cov < d <= last_td)
+    stale = lag >= STALE_LAG_TRADING_DAYS
+    quar = sorted(str(q.relative_to(root)) for q in root.glob(cfg["quarantine_glob"])) if cfg.get("quarantine_glob") else []
+    disc = (f"{table}: built={man['built']}（美东）= {built_sh:%Y-%m-%d %H:%M} 上海，覆盖到 {cov.date()}，"
+            f"落后 {lag} 个交易日（asof {asof.date()}，最近交易日 {last_td.date()}，阈值 ≥{STALE_LAG_TRADING_DAYS}）；"
+            f"最后一次成分变动 {max_date.date()}；sha256 校验通过")
+    if quar:
