+"""sw_pit 过期检查 + as-of 成分自测（不联网、不写正式输出）。"""
+import sys, subprocess
+from pathlib import Path
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import pandas as pd, intel_common as C
+ok, fails = 0, []
+def check(n, c):
+    global ok
+    (ok := ok + 1) if c else fails.append(n); print("PASS" if c else "FAIL", n)
+f = C.check_table_freshness("sw_pit", "2026-10-18")
+check("返回字段齐全", set(f) == {"table", "max_date", "built", "covered_through", "lag_days", "status", "disclosure"})
+check("max_date 取自 manifest in_date_range", f["max_date"] == "2026-09-24")
+check("10-18 判 stale（lag 3 ≥ 3）", f["status"] == "stale" and f["lag_days"] == 3)
+check("10-15 判 ok（lag 2）", C.check_table_freshness("sw_pit", "2026-10-15")["status"] == "ok")
+try:
+    C.require_fresh("sw_pit", "2026-10-18"); check("stale 默认停跑", False)
+except SystemExit as e:
+    check("stale 默认停跑", "STOP" in str(e))
+check("--allow-stale 放行并带 disclosure", "STALE" in C.require_fresh("sw_pit", "2026-10-18", allow_stale=True)["disclosure"])
+sw = pd.DataFrame({"instrument_id": ["a", "b", "c"], "in_date": pd.to_datetime(["2026-09-24", "2026-09-01", "2026-08-01"]),
+                   "out_date": pd.to_datetime([None, "2026-09-24", None])})
+m = set(C.sw_members_asof(sw, "2026-09-24").instrument_id)
+check("变动当天不可用（in_date 18:00 之后才知道）", m == {"b", "c"})
+check("次日生效", set(C.sw_members_asof(sw, "2026-09-25").instrument_id) == {"a", "c"})
+for script in (("intel_event_study.py", "intel_c1_gap_split.py") if C.check_table_freshness("sw_pit")["status"] == "stale" else ()):  # 只在当前 stale 时跑，避免误触发全窗计算
+    r = subprocess.run([sys.executable, str(Path(__file__).parent / script)], capture_output=True, text=True, timeout=60)
+    check(f"{script} 无 --allow-stale 时停跑", r.returncode != 0 and "STOP" in (r.stderr + r.stdout))
+print(f"\n{ok}/{ok+len(fails)} passed"); sys.exit(1 if fails else 0)
