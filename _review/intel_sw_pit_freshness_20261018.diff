+def _trading_days() -> list:
+    """A 股交易日：以 tushare_raw/daily 文件名为准（盘上实际有日线的日子）。"""
+    return sorted(pd.Timestamp(f.stem) for f in (ROOT / "data/v2/tushare_raw/daily").glob("*.parquet"))
