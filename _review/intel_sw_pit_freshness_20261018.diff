+def check_table_freshness(table: str, asof=None) -> dict:
+    """返回 {table, max_date, built, covered_through, lag_days, status: ok/stale, disclosure}。
+    max_date = manifest 的 in_date_range[1]（没有就读 parquet date_col 的实际最大值）——只代表“最后一次成分变动”，不单独判过期；
+    built = manifest.built（构建时刻，按 Asia/Shanghai 理解）；covered_through = built 当日 18:00 前构建则取前一交易日，否则取当日；
+    lag_days = (covered_through, asof 当日或之前最后一个交易日] 内的交易日数。"""
+    cfg = FRESHNESS_TABLES[table]
+    asof = pd.Timestamp(asof or datetime.now(ET_TZ).strftime("%Y-%m-%d")).normalize()
+    man = json.loads((ROOT / cfg["manifest"]).read_text()) if (ROOT / cfg["manifest"]).exists() else {}
+    sub = man.get(cfg.get("manifest_key"), {}) if cfg.get("manifest_key") else man
+    rng = sub.get("in_date_range") or []
+    if len(rng) == 2:
+        max_date, max_src = pd.Timestamp(rng[1]), "manifest.in_date_range"
+    else:
+        max_date, max_src = pd.read_parquet(ROOT / cfg["parquet"], columns=[cfg["date_col"]])[cfg["date_col"]].max(), "parquet." + cfg["date_col"]
+    built = pd.Timestamp(man["built"]) if man.get("built") else None
+    td = _trading_days()
+    last_td = max([d for d in td if d <= asof], default=asof)
+    if built is not None:
+        bd = built.normalize()
+        cov = bd if (built.hour >= 18 and bd in td) else max([d for d in td if d < bd], default=bd)
+        lag = sum(1 for d in td if cov < d <= last_td)
+    else:
+        cov, lag = None, None
+    stale = lag is None or lag >= STALE_LAG_TRADING_DAYS
+    quar = sorted(str(q.relative_to(ROOT)) for q in ROOT.glob(cfg["quarantine_glob"])) if cfg.get("quarantine_glob") else []
+    disc = (f"{table}: built={man.get('built')}，覆盖到 {cov.date() if cov is not None else '未知'}，"
+            f"落后 {lag} 个交易日（asof {asof.date()}，最近交易日 {last_td.date()}，阈值 ≥{STALE_LAG_TRADING_DAYS}）；"
+            f"最后一次成分变动 {max_date.date()}（{max_src}）")
+    if quar:
+        disc += f"；存在未完成刷新隔离目录 {', '.join(quar)}"
+    return {"table": table, "max_date": str(max_date.date()), "built": man.get("built"),
+            "covered_through": str(cov.date()) if cov is not None else None, "lag_days": lag,
+            "status": "stale" if stale else "ok", "disclosure": disc + ("（STALE）" if stale else "")}
+
+
+def require_fresh(table: str, asof=None, allow_stale: bool = False) -> dict:
+    """事件研究 / 特征构建用：stale 默认停跑；allow_stale=True 放行并返回 disclosure 供写回执。"""
+    f = check_table_freshness(table, asof)
+    print("[freshness]", json.dumps(f, ensure_ascii=False))
+    if f["status"] != "ok" and not allow_stale:
+        raise SystemExit(f"STOP：{f['disclosure']}。如需照跑请加 --allow-stale（disclosure 会写入回执）。")
+    return f
+
+
+def sw_members_asof(sw: pd.DataFrame, d) -> pd.DataFrame:
+    """申万一级成分按时点取（as-of）：变动在 available_at（in_date 18:00 上海）之后才可用，
+    所以交易日 d 只用 in_date < d 的成分；出表同理，out_date 当天收盘后才知道，d ≤ out_date 仍视为成员。"""
+    d = pd.Timestamp(d).normalize()
+    return sw[(sw.in_date < d) & (sw.out_date.isna() | (sw.out_date >= d))]
+
